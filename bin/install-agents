#!/usr/bin/env bash
# Install the qitt and worker T3 project roots into ~/.local/state/qitt/projects/
# (QITT_PROJECTS_DIR overrides), assembled from agents/ and the enabled sources. Copies, so
# editing the repo does not change new threads until you reinstall.
#
# A source is a folder: sources/<name>/ in this repo, or ~/.config/qitt/sources/<name>/, which wins
# over a repo source of the same name. Its qitt.md and worker.md replace the
# "<!-- qitt:sources -->" line of the matching charter, its deny.txt adds to both agents' deny
# lists, and its skills/ are installed next to the shared ones. The enabled sources come from
# QITT_SOURCES (names separated by spaces or commas), else ~/.config/qitt/sources.txt (one name
# per line, # for comments), else slack and jira. See docs/sources.md.
#
# Each root gets one AGENTS.md, the instruction file coding agents read: the charter, with the
# sources' sections and the owner's local context (~/.config/qitt/context.md, QITT_CONTEXT
# overrides) written into it at the "<!-- qitt:context -->" line. Nothing is imported or linked,
# so re-run this script after editing context.md. Without a context file that section stays
# empty and the charters' fallback applies.
#
# The deny lists and the skills go under .claude/, which Claude Code reads. The Slack source
# denies the Slack MCP server's send tools by name (mcp__<server>__...). Set
# QITT_SLACK_MCP_SERVER if your Slack MCP server is not named slack-cli.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
dest=${QITT_PROJECTS_DIR:-$HOME/.local/state/qitt/projects}
own_sources=$HOME/.config/qitt/sources
slack_mcp=${QITT_SLACK_MCP_SERVER:-slack-cli}
context=${QITT_CONTEXT:-$HOME/.config/qitt/context.md}
if [[ -n ${QITT_CONTEXT:-} && ! -f $QITT_CONTEXT ]]; then
  echo "QITT_CONTEXT=$QITT_CONTEXT is not a file" >&2
  exit 1
fi
if [[ ! $slack_mcp =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "QITT_SLACK_MCP_SERVER must be an MCP server name (letters, digits, - and _)" >&2
  exit 1
fi

if [[ -n ${QITT_SOURCES+set} ]]; then
  enabled=$QITT_SOURCES
elif [[ -f $HOME/.config/qitt/sources.txt ]]; then
  enabled=$(sed 's/#.*//' "$HOME/.config/qitt/sources.txt")
else
  enabled="slack jira"
fi
read -r -a wanted <<<"$(tr '\n,' '  ' <<<"$enabled")"

names=()
dirs=()
for name in ${wanted[@]+"${wanted[@]}"}; do
  if [[ ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "source name '$name' must be lowercase letters, digits and -" >&2
    exit 1
  fi
  case " ${names[*]-} " in *" $name "*) continue ;; esac
  if [[ -d $own_sources/$name ]]; then
    dir=$own_sources/$name
  elif [[ -d $repo/sources/$name ]]; then
    dir=$repo/sources/$name
  else
    echo "source '$name' is in neither $own_sources nor $repo/sources" >&2
    exit 1
  fi
  if [[ ! -f $dir/qitt.md ]]; then
    echo "source '$name' has no qitt.md in $dir" >&2
    exit 1
  fi
  names+=("$name")
  dirs+=("$dir")
done

# Every skills/ folder to install: the shared one, then each source's. Two of them must not hold
# a skill of the same name: copying both would mix their files in one folder. Checked here,
# before anything is written.
skill_dirs=()
skill_names=()
skill_owners=()
for skills in "$repo/skills" ${dirs[@]+"${dirs[@]/%//skills}"}; do
  if [[ ! -d $skills ]]; then continue; fi
  for entry in "$skills"/*; do
    if [[ ! -e $entry ]]; then continue; fi
    skill=${entry##*/}
    for i in ${skill_names[@]+"${!skill_names[@]}"}; do
      if [[ ${skill_names[$i]} == "$skill" ]]; then
        echo "skill '$skill' is in both ${skill_owners[$i]} and $skills; rename one of them" >&2
        exit 1
      fi
    done
    skill_names+=("$skill")
    skill_owners+=("$skills")
  done
  skill_dirs+=("$skills")
done

context_file=
if [[ -f $context ]]; then context_file=$context; fi

sections=$(mktemp)
trap 'rm -f "$sections"' EXIT

for agent in qitt worker; do
  src=$repo/agents/$agent
  dst=$dest/$agent
  mkdir -p "$dst/.claude"

  # This agent's section from each enabled source, one blank line apart.
  : >|"$sections"
  deny=()
  for dir in ${dirs[@]+"${dirs[@]}"}; do
    if [[ -f $dir/$agent.md ]]; then
      if [[ -s $sections ]]; then echo >>"$sections"; fi
      cat "$dir/$agent.md" >>"$sections"
    fi
    if [[ -f $dir/deny.txt ]]; then deny+=("$dir/deny.txt"); fi
  done
  if [[ ! -s $sections ]]; then echo "No source is installed." >>"$sections"; fi

  # The charter with both markers filled in. It holds the owner's context, so it is private from
  # the moment it is created.
  missing=0
  (umask 077 && awk -v sections="$sections" -v context="$context_file" '
    $0 == "<!-- qitt:sources -->" { while ((getline line < sections) > 0) print line; sources = 1; next }
    $0 == "<!-- qitt:context -->" {
      if (context != "") while ((getline line < context) > 0) print line
      local = 1
      next
    }
    { print }
    END { if (!sources) exit 2; if (!local) exit 3 }' "$src/AGENTS.md" >|"$dst/AGENTS.md.tmp") || missing=$?
  if [[ $missing -ne 0 ]]; then
    rm -f "$dst/AGENTS.md.tmp"
    case $missing in
      2) echo "$src/AGENTS.md has no <!-- qitt:sources --> line" >&2 ;;
      3) echo "$src/AGENTS.md has no <!-- qitt:context --> line" >&2 ;;
      *) echo "could not assemble $dst/AGENTS.md" >&2 ;;
    esac
    exit 1
  fi
  mv -f "$dst/AGENTS.md.tmp" "$dst/AGENTS.md"
  # Files earlier versions installed. A CLAUDE.md left here would make Claude Code read it
  # instead of AGENTS.md.
  rm -f "$dst/CLAUDE.md" "$dst/context.local.md"

  # The agent's own settings, plus every tool the enabled sources deny.
  node -e '
    const { readFileSync } = require("node:fs");
    const [base, ...lists] = process.argv.slice(1);
    const settings = JSON.parse(readFileSync(base, "utf8"));
    const deny = new Set(settings.permissions?.deny ?? []);
    for (const list of lists) {
      for (const line of readFileSync(list, "utf8").split("\n")) {
        const tool = line.trim();
        if (tool && !tool.startsWith("#")) deny.add(tool);
      }
    }
    settings.permissions = { ...settings.permissions, deny: [...deny] };
    console.log(JSON.stringify(settings, null, 2));
  ' "$src/.claude/settings.json" ${deny[@]+"${deny[@]}"} |
    sed "s/mcp__slack-cli__/mcp__${slack_mcp}__/g" >|"$dst/.claude/settings.json.tmp"
  chmod 0644 "$dst/.claude/settings.json.tmp"
  mv -f "$dst/.claude/settings.json.tmp" "$dst/.claude/settings.json"

  # Shared skills (skills/<name>/) and each source's own go into both roots; replace so
  # removed skills disappear.
  rm -rf "$dst/.claude/skills"
  for skills in ${skill_dirs[@]+"${skill_dirs[@]}"}; do
    mkdir -p "$dst/.claude/skills"
    cp -R "$skills/." "$dst/.claude/skills/"
  done
  echo "installed $dst"
done

echo "sources: ${names[*]-none}"
if [[ -f $context ]]; then
  echo "local context written in from $context; re-run after editing it"
else
  echo "warning: $context is missing, so the charters hold no local context;" \
    "start from config/example/context.md, then re-run" >&2
fi
