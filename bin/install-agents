#!/usr/bin/env bash
# Install the qitt and worker T3 project roots into ~/.local/state/qitt/projects/
# (QITT_PROJECTS_DIR overrides), assembled from agents/ and the enabled input sources. Copies, so
# editing the repo does not change new threads until you reinstall.
#
# An input source is a folder: input-sources/<name>/ in this repo, or
# ~/.config/qitt/input-sources/<name>/, which wins over a repo source of the same name. Its qitt.md
# and worker.md replace the "<!-- qitt:sources -->" line of the matching charter, and its deny.txt
# adds to both agents' deny lists. The enabled sources come from QITT_INPUT_SOURCES (names
# separated by spaces or commas), else ~/.config/qitt/input-sources.txt (one name per line, # for
# comments), else slack and jira. See docs/input-sources.md.
#
# Each root gets one AGENTS.md, the instruction file coding agents read: the charter, with the
# sources' sections and the owner's local context (~/.config/qitt/context.md, QITT_CONTEXT
# overrides) written into it at the "<!-- qitt:context -->" line. Nothing is imported or linked,
# so re-run this script after editing context.md. Without a context file that section stays
# empty and the charters' fallback applies.
#
# Next to it goes a CLAUDE.md that only imports it ("@AGENTS.md"), under a comment that says why.
# Claude Code reads AGENTS.md by itself only when it finds no CLAUDE.md in the root or above it,
# and it then also loads every AGENTS.md above the root. With its own CLAUDE.md the root is read
# the same way wherever it is.
#
# The deny lists go under .claude/, which Claude Code reads. The Slack source denies the Slack
# MCP server's send tools by name (mcp__<server>__...). Set QITT_SLACK_MCP_SERVER if your Slack
# MCP server is not named slack-cli.
#
# No skill or MCP server is installed: the agents use the ones their own setup has, and the local
# context names them.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
dest=${QITT_PROJECTS_DIR:-$HOME/.local/state/qitt/projects}
own_sources=$HOME/.config/qitt/input-sources
slack_mcp=${QITT_SLACK_MCP_SERVER:-slack-cli}
context=${QITT_CONTEXT:-$HOME/.config/qitt/context.md}
if [[ -n ${QITT_CONTEXT:-} && ! -f $QITT_CONTEXT ]]; then
  echo "QITT_CONTEXT=$QITT_CONTEXT is not a file" >&2
  exit 1
fi
if [[ ! $slack_mcp =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "QITT_SLACK_MCP_SERVER must be an MCP server name (letters, digits, - and _)" >&2
  exit 1
fi

if [[ -n ${QITT_INPUT_SOURCES+set} ]]; then
  enabled=$QITT_INPUT_SOURCES
elif [[ -f $HOME/.config/qitt/input-sources.txt ]]; then
  enabled=$(sed 's/#.*//' "$HOME/.config/qitt/input-sources.txt")
else
  enabled="slack jira"
fi
read -r -a wanted <<<"$(tr '\n,' '  ' <<<"$enabled")"

names=()
dirs=()
for name in ${wanted[@]+"${wanted[@]}"}; do
  if [[ ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "source name '$name' must be lowercase letters, digits and -" >&2
    exit 1
  fi
  case " ${names[*]-} " in *" $name "*) continue ;; esac
  if [[ -d $own_sources/$name ]]; then
    dir=$own_sources/$name
  elif [[ -d $repo/input-sources/$name ]]; then
    dir=$repo/input-sources/$name
  else
    echo "input source '$name' is in neither $own_sources nor $repo/input-sources" >&2
    exit 1
  fi
  if [[ ! -f $dir/qitt.md ]]; then
    echo "source '$name' has no qitt.md in $dir" >&2
    exit 1
  fi
  names+=("$name")
  dirs+=("$dir")
done

# A context file that is there but cannot be read stops the install here, before anything is
# written: installing without it would silently put qitt back in shadow mode.
context_file=
if [[ -f $context ]]; then
  if [[ ! -r $context ]]; then
    echo "$context cannot be read" >&2
    exit 1
  fi
  context_file=$context
fi

sections=$(mktemp)
trap 'rm -f "$sections"' EXIT

for agent in qitt worker; do
  src=$repo/agents/$agent
  dst=$dest/$agent
  mkdir -p "$dst/.claude"

  # This agent's section from each enabled source, one blank line apart.
  : >|"$sections"
  deny=()
  for dir in ${dirs[@]+"${dirs[@]}"}; do
    if [[ -f $dir/$agent.md ]]; then
      if [[ -s $sections ]]; then echo >>"$sections"; fi
      cat "$dir/$agent.md" >>"$sections"
    fi
    if [[ -f $dir/deny.txt ]]; then deny+=("$dir/deny.txt"); fi
  done
  if [[ ! -s $sections ]]; then echo "No source is installed." >>"$sections"; fi

  # The charter with both markers filled in. It holds the owner's context, so it is private from
  # the moment it is created.
  missing=0
  (umask 077 && awk -v sections="$sections" -v context="$context_file" '
    $0 == "<!-- qitt:sources -->" { while ((getline line < sections) > 0) print line; sources = 1; next }
    $0 == "<!-- qitt:context -->" {
      if (context != "") {
        while ((got = (getline line < context)) > 0) print line
        if (got < 0) { unread = 1; exit }
      }
      local = 1
      next
    }
    { print }
    END { if (unread) exit 4; if (!sources) exit 2; if (!local) exit 3 }' "$src/AGENTS.md" >|"$dst/AGENTS.md.tmp") || missing=$?
  if [[ $missing -ne 0 ]]; then
    rm -f "$dst/AGENTS.md.tmp"
    case $missing in
      2) echo "$src/AGENTS.md has no <!-- qitt:sources --> line" >&2 ;;
      3) echo "$src/AGENTS.md has no <!-- qitt:context --> line" >&2 ;;
      4) echo "$context cannot be read" >&2 ;;
      *) echo "could not assemble $dst/AGENTS.md" >&2 ;;
    esac
    exit 1
  fi
  mv -f "$dst/AGENTS.md.tmp" "$dst/AGENTS.md"
  # Claude Code's way in: its own file name, pointing at the charter. This also replaces the
  # full CLAUDE.md an earlier version installed.
  cat >|"$dst/CLAUDE.md.tmp" <<'SHIM'
<!--
Written by qitt's bin/install-agents. Do not edit: the charter is the AGENTS.md next to this file.

This file only points Claude Code at it, with the import below. Claude Code reads an AGENTS.md
by itself only when it finds no CLAUDE.md in this folder or above it, and it then also loads
every AGENTS.md above this folder. So without this file:

- an AGENTS.md in the home directory would be added to every thread, on top of the same
  instructions Claude Code already loads as its global file;
- a CLAUDE.md above this folder would keep the charter from loading at all. That is what
  ~/.claude/CLAUDE.md is when Claude Code runs with another config directory.

Other agents ignore this file and read AGENTS.md directly.
-->

@AGENTS.md
SHIM
  chmod 0644 "$dst/CLAUDE.md.tmp"
  mv -f "$dst/CLAUDE.md.tmp" "$dst/CLAUDE.md"
  rm -f "$dst/context.local.md"

  # The agent's own settings, plus every tool the enabled sources deny.
  node -e '
    const { readFileSync } = require("node:fs");
    const [base, ...lists] = process.argv.slice(1);
    const settings = JSON.parse(readFileSync(base, "utf8"));
    const deny = new Set(settings.permissions?.deny ?? []);
    for (const list of lists) {
      for (const line of readFileSync(list, "utf8").split("\n")) {
        const tool = line.trim();
        if (tool && !tool.startsWith("#")) deny.add(tool);
      }
    }
    settings.permissions = { ...settings.permissions, deny: [...deny] };
    console.log(JSON.stringify(settings, null, 2));
  ' "$src/.claude/settings.json" ${deny[@]+"${deny[@]}"} |
    sed "s/mcp__slack-cli__/mcp__${slack_mcp}__/g" >|"$dst/.claude/settings.json.tmp"
  chmod 0644 "$dst/.claude/settings.json.tmp"
  mv -f "$dst/.claude/settings.json.tmp" "$dst/.claude/settings.json"

  # Skills that earlier versions installed here. qitt ships none: the agents use the ones their
  # own setup has.
  rm -rf "$dst/.claude/skills"
  echo "installed $dst"
done

echo "input sources: ${names[*]-none}"
if [[ -f $context ]]; then
  echo "local context written in from $context; re-run after editing it"
else
  echo "warning: $context is missing, so the charters hold no local context;" \
    "start from config/example/context.md, then re-run" >&2
fi
